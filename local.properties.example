# Template local.properties untuk development lokal.
# Copy file ini menjadi local.properties (jangan commit local.properties ke git).

# Wajib: lokasi Android SDK (pilih salah satu sesuai OS Anda)
# Windows
# sdk.dir=C\:\\Users\\USERNAME\\AppData\\Local\\Android\\Sdk
# macOS
# sdk.dir=/Users/USERNAME/Library/Android/sdk
# Linux
# sdk.dir=/home/USERNAME/Android/Sdk

# Contoh opsional untuk secret konfigurasi lokal
# API_KEY_QUOTES=isi_dengan_api_key_rahasia_anda
# BASE_URL=https://api.example.com/

# Setelah local.properties dibuat dan sdk.dir valid, jalankan integration test:
# ./gradlew connectedDebugAndroidTest
